# =============================================================================
# Equipment Rental App - Comprehensive Root .gitignore
# =============================================================================

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.bak
*~

# --- IDEs & Editors ---
.idea/
*.iml
*.iws
*.ipr
.vscode/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# --- .NET & C# Artifacts (backend/RentalApi) ---
backend/**/[Bb]in/
backend/**/[Oo]bj/
**/out/
*.pidb
*.booproj
*.userprefs
*.vspscc
*.vssscc
*.build-info
launchSettings.json.user

# --- Flutter & Dart Artifacts (mobile & server) ---
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/build/
**/coverage/
**/doc/api/
.widget_preview/
migrate_working_dir/

# --- Android Artifacts (mobile/android) ---
mobile/android/.gradle/
mobile/android/.kotlin/
mobile/android/local.properties
mobile/android/app/debug
mobile/android/app/profile
mobile/android/app/release
*.apk
*.aab
*.keystore
*.jks

# --- iOS & macOS Artifacts (mobile/ios, mobile/macos) ---
**/ios/Flutter/.last_build_id
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.framework
**/ios/Flutter/Flutter.framework
**/ios/.symlinks/
**/Pods/
**/Podfile.lock
**/DerivedData/
**/*.xcscmblueprint
**/*.xccheckout
**/xcuserdata/

# --- Windows Flutter Artifacts (mobile/windows) ---
mobile/windows/flutter/ephemeral/

# --- Environment & Sensitive Local Secrets ---
*.env
*.env.*
*.local
*.pfx
*.key
*.pem
*.cert

# Ảnh do người dùng upload, không phải source code
backend/**/wwwroot/uploads/
